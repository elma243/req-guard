# Copy this file to backend/.env and fill in the values.
# Never commit backend/.env.

# --- Database ---
# Leave empty to use a local SQLite file (backend/reqguard.db).
# Supabase (Connect > Session pooler), with the psycopg driver:
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
# Tests always use in-memory SQLite, whatever is set here.
DATABASE_URL=

# --- LLM ---
# Providers asked in this order (comma-separated: groq, gemini). The next one is asked only when one is
# overloaded (503), rate limited / out of quota (429) or times out. A provider without its key is skipped.
# When none answers, extraction falls back to simple rules ("rule-based").
LLM_CHAIN=groq,gemini

# Groq: key from console.groq.com > API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini. LLM_MODEL example: gemini-3.8-flash
# LLM_API_KEY: from Google AI Studio (aistudio.google.com > Get API key)
LLM_MODEL=
LLM_API_KEY=
# Optional. Asked once when LLM_MODEL is overloaded (503), rate limited, times out or is out of daily quota.
# Use an older, less busy model that accepts the same thinking level, e.g. gemini-3.5-flash. Empty: no fallback.
LLM_FALLBACK_MODEL=
# Seconds to wait for one LLM response
LLM_TIMEOUT_SECONDS=120
# Gemini thinking level for requirement extraction: minimal | low | medium | high, or default (model decides).
# Use the lowest level your model accepts: "low" for gemini-3.8-flash ("minimal" is rejected there).
LLM_EXTRACTION_THINKING=low

# --- Similarity checks (duplicates, conflicts, change requests) ---
# Local CPU models, downloaded on first use (~670 MB) and kept in the Hugging Face cache. Together they need
# about 1-1.2 GB of RAM: set SIMILARITY_ENABLED=false on small instances (e.g. Render free, 512 MB); the
# rule-based checks still run. The embedding model must give 384-dimension vectors (the column is vector(384)).
SIMILARITY_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small
# Similarity (0-1) to an accepted requirement from which a different one may be a change request
CHANGE_REQUEST_SIMILARITY=0.75
# Every flagged pair is also checked by the LLM (LLM_CHAIN above). Without an answering LLM the findings are kept
# but marked "unconfirmed".

# --- Auto-sync of connected sources ---
# A background task inside the API process syncs sources that have "Auto-sync" on, at their interval
# (1, 5, 15 or 60 minutes). It needs exactly ONE backend worker: run `uvicorn app.main:app` without --workers
# and with one instance on Render/Railway. With several workers or instances, set this to false.
# Tests always run with it off.
AUTO_SYNC_ENABLED=true

# --- Voice notes ---
# Voice notes from every source are transcribed with Groq Whisper (uses GROQ_API_KEY above). A background worker in
# the API process sends them one by one, at most GROQ_AUDIO_RPM per minute (Groq free tier: 20). Like auto-sync it
# needs ONE backend worker; set TRANSCRIPTION_WORKER_ENABLED=false with several workers. Tests always run with it off.
TRANSCRIPTION_WORKER_ENABLED=true
WHISPER_MODEL=whisper-large-v3
# Asked once when WHISPER_MODEL is busy, rate limited or fails
WHISPER_FALLBACK_MODEL=whisper-large-v3-turbo
GROQ_AUDIO_RPM=20
# true keeps the audio in the database after transcription (play button on the Messages page). false deletes it
# once the transcript is saved. Audio waiting for transcription, or whose transcription failed, is always kept.
KEEP_AUDIO=false

# --- Jira Cloud ---
# e.g. https://your-site.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Slack (bot token, scopes: channels:history, channels:read, files:read) ---
# files:read is needed for voice notes (audio clips and audio uploads); reinstall the app after adding it.
SLACK_BOT_TOKEN=

# --- Telegram (bot from @BotFather, privacy mode off) ---
TELEGRAM_BOT_TOKEN=

# --- Discord (bot with Message Content intent) ---
DISCORD_BOT_TOKEN=

# --- Gmail (Google Cloud OAuth client, test mode) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must also be added as an "Authorized redirect URI" of the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/gmail/callback

# --- Encryption of stored connector tokens (Gmail refresh token) ---
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- GitHub (repo read, PR comment) ---
GITHUB_TOKEN=

# --- Auth (JWT) ---
# Required for register/login. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Token lifetime in minutes (1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440
# Login, register, OTP and forgot-password attempts per minute, per IP and per email
AUTH_RATE_LIMIT_PER_MINUTE=5
# Same value as PROXY_SHARED_SECRET in frontend/.env.local. Required in production: without it the backend sees
# only the Next.js server's address, so all users share one rate limit. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_SHARED_SECRET=

# --- Email (sign-up codes and password reset links) ---
# Leave SMTP_HOST empty to print emails to the backend console instead (dev mode).
# Port 465 uses TLS from the start; any other port upgrades with STARTTLS (compulsory when SMTP_USER is set).
# Gmail: smtp.gmail.com, port 587, and an App Password (Google Account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# e.g. ReqGuard <you@example.com>. Empty: SMTP_USER is used.
EMAIL_FROM=

# --- Frontend origins allowed to call the API (comma-separated) ---
CORS_ORIGINS=http://localhost:3000
# Where the Gmail OAuth callback sends the browser back to
FRONTEND_URL=http://localhost:3000
